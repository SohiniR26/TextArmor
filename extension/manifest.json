{
  "manifest_version": 3,
  "name": "Text Armor — Active Shield",
  "version": "2.5.0",
  "description": "Enterprise-grade real-time NLP content screening, adversarial robustness, and active input defense.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Text Armor Active Shield"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
